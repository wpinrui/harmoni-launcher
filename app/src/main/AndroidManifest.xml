<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Package visibility. Without this the app index would only see apps Harmoni has already
        interacted with until it is made the default home app. Matching MAIN + LAUNCHER gives
        exactly the launchable set, which is all the launcher ever shows, so QUERY_ALL_PACKAGES
        is not needed.
    -->
    <!--
        Motion, for the contextual ring's transit rules. Runtime permission, asked for on first
        launch; refused simply leaves motion unknown and those rules idle.
    -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!--
        Launch history and session lengths, which the pair pulls, the dormancy ramp and the
        monthly reconciliation all read. Granted by hand in Settings, like notification access.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        The wallpaper, so the search view can draw a blurred copy of it. The window manager can
        only blur what is behind a window, and the wallpaper is drawn by this one, so the blur has
        to be ours. Reading it is gated on all-files access rather than image access, which is a
        toggle in Settings rather than a prompt. Without it the search view keeps its tint alone.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!--
        The undocumented route to the notification shade, tried before the accessibility service.
        An ordinary permission; whether the hidden method behind it is reachable is up to the
        device rather than the grant.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!--
        The shortcut gestures address the vibrator directly rather than through the framework's
        stock ticks, which are too light to feel as the launched app takes the screen.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".HarmoniApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Harmoni">

        <!--
            configChanges is deliberately broad: the home surface holds live gesture state and
            recreating it on a rotation or a theme change would drop a stroke mid-letter.
        -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:theme="@style/Theme.Harmoni.Home">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Harmoni opened as an app. This carries the launcher filter rather than HomeActivity,
            which would otherwise offer a way of navigating to the screen you are already on.
        -->
        <activity
            android:name=".app.LauncherAppActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Harmoni">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The alphabet capture tool, reached from the launcher app screen. -->
        <activity
            android:name=".graffiti.GraffitiCaptureActivity"
            android:exported="false"
            android:label="@string/graffiti_capture"
            android:theme="@style/Theme.Harmoni" />

        <!-- The hidden apps list, reached from the launcher app screen. -->
        <activity
            android:name=".app.HiddenAppsActivity"
            android:exported="false"
            android:label="@string/hidden_apps"
            android:theme="@style/Theme.Harmoni" />

        <!--
            Bound by the system once notification access is granted by hand in Settings. It feeds
            the badge counts, and its component is also the token that lets Harmoni read active
            media sessions for the music element.
        -->
        <service
            android:name=".system.HarmoniNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Bound once accessibility access is granted by hand. It exists only to open the
            notification shade, which no app can do any other supported way.
        -->
        <service
            android:name=".system.HarmoniAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <!-- Activity recognition delivers its results to a broadcast, not a callback. -->
        <receiver
            android:name="com.wpinrui.harmoni.context.MotionReceiver"
            android:exported="false" />
    </application>

</manifest>
