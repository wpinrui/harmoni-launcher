<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is worth carrying between devices. Ring bindings, aliases and the Graffiti alphabet
    all live in source, and the diagnostics log is only meaningful for the device that produced
    it, so both cloud backup and device transfer are excluded outright.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
